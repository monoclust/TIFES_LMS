generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InstitutionStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
}

enum Role {
  SUPER_ADMIN
  INSTITUTION_COORDINATOR
  STUDENT
  MENTOR
  INSTRUCTOR
  INSTITUTION_VIEWER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  WITHDRAWN
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  WITHDRAWN
  TRANSFERRED
}

enum SubmissionStatus {
  SUBMITTED
  IN_REVIEW
  REVISION_REQUESTED
  RESUBMITTED
  FINALIZED
  WITHDRAWN
}

enum ReviewDecision {
  REVISION_REQUESTED
  ACCEPTED
  FINALIZED
}

model Institution {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  status      InstitutionStatus @default(ACTIVE)
  timezone    String            @default("Asia/Kolkata")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  memberships Membership[]
  invitations Invitation[]
  students    StudentRecord[]
  programmes  Programme[]
  batches     Batch[]
  classes     LearningClass[]
  projects    Project[]
  assignments ProjectAssignment[]
  auditLogs   AuditLog[]

  @@index([status, createdAt])
}

model User {
  id                String        @id @default(cuid())
  name              String?
  email             String?       @unique
  emailVerified     DateTime?
  image             String?
  status            UserStatus    @default(INVITED)
  passwordHash      String?
  accountSetupAt    DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  accounts          Account[]
  sessions          Session[]
  memberships       Membership[]
  invitationsSent   Invitation[]  @relation("InvitationSender")
  studentRecords    StudentRecord[] @relation("StudentLinkedUser")
  submissions       Submission[]  @relation("SubmissionAuthor")
  notifications     Notification[]
  auditEvents       AuditLog[]    @relation("AuditActor")

  @@index([status, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Membership {
  id             String      @id @default(cuid())
  institutionId  String
  userId         String
  role           Role
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  institution    Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedClasses LearningClass[] @relation("ClassInstructor")
  assignedProjects ProjectAssignment[] @relation("AssignedMentor")
  reviews        Review[]    @relation("ReviewMentor")

  @@unique([institutionId, userId, role])
  @@index([userId, isActive])
  @@index([institutionId, role, isActive])
}

model Invitation {
  id                String           @id @default(cuid())
  institutionId     String
  email             String
  role              Role
  tokenHash         String           @unique
  status            InvitationStatus @default(PENDING)
  expiresAt         DateTime
  acceptedAt        DateTime?
  revokedAt         DateTime?
  invitedByUserId   String
  createdAt         DateTime         @default(now())
  institution       Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  invitedBy         User             @relation("InvitationSender", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  @@index([institutionId, status, expiresAt])
  @@index([email, status])
}

model StudentRecord {
  id             String        @id @default(cuid())
  institutionId  String
  linkedUserId   String?
  studentCode    String
  name           String
  email          String?
  phone          String?
  status         StudentStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  institution    Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  linkedUser     User?         @relation("StudentLinkedUser", fields: [linkedUserId], references: [id], onDelete: SetNull)
  enrollments    Enrollment[]
  submissions    Submission[]

  @@unique([institutionId, studentCode])
  @@index([institutionId, status, name])
  @@index([linkedUserId])
}

model Programme {
  id             String      @id @default(cuid())
  institutionId  String
  name           String
  code           String
  description    String?     @db.Text
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  institution    Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  batches        Batch[]

  @@unique([institutionId, code])
  @@index([institutionId, isActive, name])
}

model Batch {
  id             String      @id @default(cuid())
  institutionId  String
  programmeId    String
  name           String
  code           String
  startsAt       DateTime?
  endsAt         DateTime?
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  institution    Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  programme      Programme   @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  enrollments    Enrollment[]
  classes        LearningClass[]
  assignments    ProjectAssignment[]

  @@unique([institutionId, code])
  @@index([institutionId, programmeId, isActive])
}

model Enrollment {
  id          String           @id @default(cuid())
  studentId   String
  batchId     String
  status      EnrollmentStatus @default(ACTIVE)
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?
  student     StudentRecord    @relation(fields: [studentId], references: [id], onDelete: Restrict)
  batch       Batch            @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@unique([studentId, batchId])
  @@index([batchId, status])
  @@index([studentId, status])
}

model LearningClass {
  id               String      @id @default(cuid())
  institutionId    String
  batchId          String?
  instructorMembershipId String?
  title            String
  description      String?     @db.Text
  startsAt         DateTime?
  endsAt            DateTime?
  meetingUrl       String?
  isPublished      Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  institution      Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  batch            Batch?      @relation(fields: [batchId], references: [id], onDelete: SetNull)
  instructor       Membership? @relation("ClassInstructor", fields: [instructorMembershipId], references: [id], onDelete: SetNull)
  resources        ClassResource[]

  @@index([institutionId, startsAt])
  @@index([batchId, isPublished])
  @@index([instructorMembershipId])
}

model ClassResource {
  id          String       @id @default(cuid())
  classId     String
  title       String
  description String?      @db.Text
  resourceUrl String?
  fileKey     String?
  position    Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  learningClass LearningClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId, position])
}

model Project {
  id             String      @id @default(cuid())
  institutionId  String?
  title          String
  summary        String?     @db.Text
  instructions   String      @db.Text
  rubricVersion  Int         @default(1)
  isTemplate     Boolean     @default(false)
  isActive       Boolean     @default(true)
  createdByUserId String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  institution    Institution? @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  criteria       RubricCriterion[]
  assignments    ProjectAssignment[]

  @@index([institutionId, isTemplate, isActive])
}

model RubricCriterion {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  description String?  @db.Text
  maxScore    Decimal  @db.Decimal(7, 2)
  position    Int      @default(0)
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewScores ReviewCriterionScore[]

  @@index([projectId, position])
}

model ProjectAssignment {
  id                  String      @id @default(cuid())
  institutionId       String
  projectId           String
  batchId             String
  assignedMentorMembershipId String?
  titleOverride       String?
  dueAt               DateTime?
  isActive            Boolean     @default(true)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  institution         Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  project             Project     @relation(fields: [projectId], references: [id], onDelete: Restrict)
  batch               Batch       @relation(fields: [batchId], references: [id], onDelete: Restrict)
  assignedMentor      Membership? @relation("AssignedMentor", fields: [assignedMentorMembershipId], references: [id], onDelete: SetNull)
  submissions         Submission[]

  @@index([institutionId, batchId, isActive, dueAt])
  @@index([assignedMentorMembershipId])
}

model Submission {
  id             String           @id @default(cuid())
  assignmentId   String
  studentId      String
  submittedByUserId String?
  version        Int
  repositoryUrl  String
  notes          String?          @db.Text
  status         SubmissionStatus @default(SUBMITTED)
  submittedAt    DateTime         @default(now())
  assignment     ProjectAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  student        StudentRecord    @relation(fields: [studentId], references: [id], onDelete: Restrict)
  submittedBy    User?            @relation("SubmissionAuthor", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  reviews        Review[]

  @@unique([assignmentId, studentId, version])
  @@index([assignmentId, status, submittedAt])
  @@index([studentId, submittedAt])
}

model Review {
  id                 String         @id @default(cuid())
  submissionId       String
  mentorMembershipId String
  decision           ReviewDecision
  feedback           String         @db.Text
  isFinal             Boolean        @default(false)
  finalizedAt        DateTime?
  createdAt          DateTime       @default(now())
  submission         Submission     @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  mentor             Membership     @relation("ReviewMentor", fields: [mentorMembershipId], references: [id], onDelete: Restrict)
  criteriaScores     ReviewCriterionScore[]

  @@index([submissionId, createdAt])
  @@index([mentorMembershipId, createdAt])
  @@index([isFinal, finalizedAt])
}

model ReviewCriterionScore {
  id          String          @id @default(cuid())
  reviewId    String
  criterionId String
  score       Decimal         @db.Decimal(7, 2)
  comment     String?         @db.Text
  review      Review          @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  criterion   RubricCriterion @relation(fields: [criterionId], references: [id], onDelete: Restrict)

  @@unique([reviewId, criterionId])
  @@index([criterionId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  payload   Json
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model AuditLog {
  id            String       @id @default(cuid())
  institutionId String?
  actorUserId   String?
  action        String
  targetType    String
  targetId      String?
  safeMetadata Json?
  createdAt     DateTime     @default(now())
  institution   Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  actor         User?        @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([institutionId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetType, targetId])
}
